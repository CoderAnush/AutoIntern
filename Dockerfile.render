FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install requirements for BOTH API and Worker
COPY services/api/requirements.txt /app/services/api/requirements.txt
COPY services/worker/requirements.txt /app/services/worker/requirements.txt
RUN pip install --no-cache-dir -r /app/services/api/requirements.txt
RUN pip install --no-cache-dir -r /app/services/worker/requirements.txt

# Copy all code
COPY . /app

# Make the start script executable
RUN chmod +x /app/render_start.sh

# Expose port (Render sets $PORT automatically, defaulting to 8000)
EXPOSE 8000

CMD ["/app/render_start.sh"]
