# ============================================================
# AutoIntern — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: uses SQLite (no setup required)
DATABASE_URL=sqlite+aiosqlite:///./autointern.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://autointern:CHANGE_ME@localhost:5432/autointern

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_random_hex_string

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Password policy ───────────────────────────────────────────────────────────
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHARS=true
REQUIRE_NUMBERS=true
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development: allow all origins
CORS_ORIGINS=*
# Production: comma-separated list
# CORS_ORIGINS=https://autointern.vercel.app,https://www.autointern.io

# ── Redis (optional — required for DLQ and background workers) ────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → 2-Step → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your@gmail.com
SENDER_PASSWORD=your_app_specific_password_here

# ── File storage (local by default; MinIO/S3 for production) ─────────────────
# Local storage is used when MINIO_ENDPOINT is empty or unset.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes

# ── Admin API ─────────────────────────────────────────────────────────────────
# Protects /api/admin/* endpoints. Generate a strong random value.
ADMIN_API_KEY=CHANGE_ME_strong_random_admin_key

# ── AI / Gemini (optional — used for LLM-powered explanations) ────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Behaviour ────────────────────────────────────────────────────────────────
# Set true in local dev to auto-run Alembic migrations on startup
MIGRATE_ON_START=false
