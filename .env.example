# ==================== REQUIRED FOR PRODUCTION ====================

# Database Connection URL (PostgreSQL recommended)
DATABASE_URL=postgresql+asyncpg://autointern:autointern@postgres:5432/autointern

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-random-secret-key-64-characters-minimum-change-this-in-production

# Redis URL (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Gemini API Key (get one free at: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Admin API Key for privileged operations
ADMIN_API_KEY=your-strong-admin-key

# ==================== OPTIONAL - EMAIL NOTIFICATIONS ====================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=noreply@autointern.com
SENDER_PASSWORD=your-app-specific-email-password

# ==================== OPTIONAL - FILE STORAGE ====================

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes

# ==================== APPLICATION SETTINGS ====================

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MIN_PASSWORD_LENGTH=8
REQUIRE_SPECIAL_CHARS=true
REQUIRE_NUMBERS=true
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true

# ==================== CORS CONFIGURATION ====================

CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# ==================== DATABASE MIGRATION ====================

MIGRATE_ON_START=false
